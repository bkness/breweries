{
  "name": "localbreweries",
  "version": "1.0.0",
  "description": "# User Story",
  "main": "server.js",
  "scripts": {
    "copy:bootstrap": "mkdir -p public/lib/bootstrap && cp -R node_modules/bootstrap/dist/* public/lib/bootstrap/",
    "postinstall": "npm run copy:bootstrap",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "concurrently \"nodemon --watch . --ext js,handlebars --exec node server.js\" \"browser-sync start --proxy 'localhost:3001' --files 'public/**/*, views/**/*' --no-open --no-ui --port 3000\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "connect-session-sequelize": "^7.1.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "express-session": "^1.17.3",
    "handlebars": "^4.7.8",
    "jquery": "^3.7.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "validator": "^13.12.0",
    "tar": "^7.5.11",
    "uuid": "^9.0.0",
    "@tootallnate/once": ">=3.0.1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
